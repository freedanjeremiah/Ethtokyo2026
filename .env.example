# RPC endpoints
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545

# Private keys (fresh keys only — never anvil default mnemonic accounts, never commit real values)
VENDOR_PK=
OPERATOR_PK=
SHOPA_PK=
SHOPB_PK=
SCAM_PK=
MIA_PK=
KAI_PK=
RIN_PK=

# Settlement / verification
SETTLEMENT_ADDRESS=

# C5 counterparty screening (server side only; see docs/intercepta.md)
# Intercepta W3A API key (request via https://docs.web3antivirus.io/reference/getting-started-1). Empty = not used.
INTERCEPTA_API_KEY=
# Optional Intercepta tuning (defaults shown)
# INTERCEPTA_BASE_URL=https://api.web3antivirus.io
# INTERCEPTA_SCAN=quick            # quick | deep
# INTERCEPTA_FLAG_AT=50            # flag when toxicScore or any trait risk >= this
# INTERCEPTA_TIMEOUT_MS=4000
# INTERCEPTA_CACHE_TTL_MS=60000
# C5 also screens against the OFAC sanctions list via the Chainalysis oracle on Ethereum mainnet (keyless, on by default).
# SCREEN_SANCTIONS=off           # disable it
# SANCTIONS_RPC_URL=https://ethereum-rpc.publicnode.com   # mainnet RPC used to read the oracle
# Optional local deny-list override (comma separated); flagged without calling any service.
SCREEN_FLAGGED=
# Set by demo-dirty-settlement.ts: the real OFAC-sanctioned address the demo points the settlement record at.
DIRTY_SETTLEMENT_ADDRESS=

# Public URL of the dashboard, written to the fleet's ENSIP-26 agent-endpoint[web] record (default http://localhost:3100)
PUBLIC_BASE_URL=

# Dashboard kill switches are signed in the viewer's browser wallet; the server never reads the *_PK keys above.
# FNS_KILL_SWITCHES=off hides them.
