# RPC endpoints
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545

# Private keys (fresh keys only — never anvil default mnemonic accounts, never commit real values)
VENDOR_PK=
OPERATOR_PK=
SHOPA_PK=
SHOPB_PK=
SCAM_PK=
MIA_PK=
KAI_PK=
RIN_PK=

# Settlement / verification
SETTLEMENT_ADDRESS=

# C5 counterparty screening (server side only; see docs/intercepta.md)
# Intercepta W3A API key (request via https://docs.web3antivirus.io/reference/getting-started-1). Empty = not used.
INTERCEPTA_API_KEY=
# Optional Intercepta tuning (defaults shown)
# INTERCEPTA_BASE_URL=https://api.web3antivirus.io
# INTERCEPTA_SCAN=quick            # quick | deep
# INTERCEPTA_FLAG_AT=50            # flag when toxicScore or any trait risk >= this
# INTERCEPTA_TIMEOUT_MS=4000
# INTERCEPTA_CACHE_TTL_MS=60000
# Static deny-list (comma separated). scripts/demo-dirty-settlement.ts appends DIRTY_SETTLEMENT_ADDRESS here.
SCREEN_FLAGGED=
# Demo "dirty" settlement address, derived from OPERATOR_PK by demo-dirty-settlement.ts
DIRTY_SETTLEMENT_ADDRESS=
